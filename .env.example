# ---- Required ----
DISCORD_TOKEN=
# Optional extra bot tokens, comma separated. Discord allows one voice channel per bot
# account per server, so each extra token lets one more meeting be recorded at once.
DISCORD_EXTRA_TOKENS=

# ---- Minutes generation (leave key empty to post the raw transcript only) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# ---- Transcription (runs locally, audio never leaves the box) ----
# tiny | base | small | medium | large-v3  (bigger = slower, better)
WHISPER_MODEL=small
# cpu, or cuda with an NVIDIA GPU and a CUDA base image
WHISPER_DEVICE=cpu
# int8 on cpu, float16 on cuda
WHISPER_COMPUTE_TYPE=int8
# empty = auto detect
WHISPER_LANGUAGE=en
# 0 = library default
WHISPER_THREADS=0
# vocabulary hint for jargon and names
WHISPER_PROMPT=OSINT, Sherlock, Maigret, SpiderFoot, Firegod

# ---- Behaviour ----
# created automatically if missing
MINUTES_CHANNEL_NAME=meeting-minutes
# humans in a voice channel before the bot joins
MIN_PARTICIPANTS=1
# channel must stay empty this long before the bot leaves
LEAVE_GRACE_SECONDS=30
# wait this long after the meeting ends before posting notes
PUBLISH_DELAY_SECONDS=120
# shorter meetings are discarded (does not apply to /minutes start)
MIN_MEETING_SECONDS=60
# roll a new session after this long
MAX_MEETING_HOURS=6
# post "Recording started" in the notes channel
ANNOUNCE_RECORDING=true
# also post the full transcript in a thread under the minutes (readable without downloading)
POST_TRANSCRIPT_INLINE=true
# keep per speaker WAVs after processing
KEEP_AUDIO=false

# ---- Optional scoping (comma separated IDs) ----
VOICE_CHANNEL_ALLOWLIST=
VOICE_CHANNEL_DENYLIST=
# slash commands appear instantly in these guilds instead of up to 1 hour globally
GUILD_IDS=

LOG_LEVEL=INFO
