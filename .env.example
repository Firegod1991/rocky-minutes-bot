# Copy this file to .env and fill in your own values. Never commit .env.

# ---- Discord (required) ----
DISCORD_TOKEN=
# Extra bot tokens, comma separated. One bot account can sit in one voice channel per server,
# so each extra token lets one more meeting run at the same time.
DISCORD_EXTRA_TOKENS=
# Server IDs, comma separated, so slash commands show up instantly
GUILD_IDS=

# ---- Language model (set at least one, or run Ollama locally for free) ----
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Anthropic key (optional)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
# Local fallback. Leave OLLAMA_URL empty to disable.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
# Local embeddings for meaning based search (ollama pull nomic-embed-text)
EMBED_MODEL=nomic-embed-text

# ---- Assistant ----
# Say "Rocky, ..." in voice or @mention the bot in text
WAKE_WORDS=rocky
VOICE_COMMANDS=true
TEXT_COMMANDS=true
VOICE_REPLIES=true
# kokoro (natural) or piper (lighter)
TTS_ENGINE=kokoro
# kokoro voices: am_michael, am_adam, am_onyx, bm_george, af_heart, bf_emma ...
TTS_VOICE=am_michael
TTS_SPEED=1.05

# ---- Google Docs and Drive (read only) ----
# Files posted in any channel are read automatically if shared as "anyone with the link can view".
# Public Drive folders work with no key. For private folders, put a service account key in ./data
# and share the folder with the service account email as Viewer.
GOOGLE_SERVICE_ACCOUNT_FILE=/data/google-service-account.json
GOOGLE_API_KEY=
# re read linked files this often
DOC_REFRESH_HOURS=6
# messages per channel to read on startup
INDEX_HISTORY_LIMIT=2000

# ---- Transcription (runs locally, audio never leaves your machine) ----
# tiny | base | small | medium | large-v3  (bigger = slower, more accurate)
WHISPER_MODEL=small
# fast model used to hear voice commands live
WHISPER_LIVE_MODEL=base.en
# cpu, or cuda with an NVIDIA GPU and a CUDA base image
WHISPER_DEVICE=cpu
# int8 on cpu, float16 on cuda
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
WHISPER_THREADS=0
# vocabulary hint for names and jargon your team uses
WHISPER_PROMPT=

# ---- Meetings ----
# created automatically if missing
MINUTES_CHANNEL_NAME=meeting-minutes
MIN_PARTICIPANTS=1
LEAVE_GRACE_SECONDS=30
PUBLISH_DELAY_SECONDS=120
MIN_MEETING_SECONDS=60
MAX_MEETING_HOURS=6
ANNOUNCE_RECORDING=true
POST_TRANSCRIPT_INLINE=true
KEEP_AUDIO=false
# comma separated channel IDs
VOICE_CHANNEL_ALLOWLIST=
VOICE_CHANNEL_DENYLIST=

LOG_LEVEL=INFO

# ---- Web research ----
# "Rocky, research ..." searches the internet (Gemini with Google Search, or Claude web search)
WEB_RESEARCH=true
# look it up online when the team's own docs and chats don't have the answer
WEB_FALLBACK=true
# Gemini's Google Search needs billing on your AI Studio project. Without it Rocky searches
# Wikipedia for free, or a search API if you add a key (both have free tiers):
# Brave: https://brave.com/search/api   Tavily: https://tavily.com
BRAVE_API_KEY=
TAVILY_API_KEY=
